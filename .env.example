# Development placeholders only. Never load production credentials into a fixture preview.
BENCHPOLL_DB_HOST=127.0.0.1
BENCHPOLL_DB_PORT=3306
BENCHPOLL_DB_USER=benchpoll_dev
BENCHPOLL_DB_NAME=benchpoll_dev
DB_PASSWORD=replace-with-a-local-only-password
SESSION_SECRET=replace-with-at-least-32-random-local-only-characters
SESSION_CLEANUP_INTERVAL_MINUTES=15
SESSION_MAX_AGE_DAYS=30
GITHUB_CLIENT_SECRET=development-placeholder-not-valid-for-login
GITHUB_MIN_ACCOUNT_AGE_DAYS=0
BENCHPOLL_BIND_HOST=127.0.0.1
BENCHPOLL_PORT=1337
PUBLIC_ORIGIN=https://localhost:1337
# Keep SMTP/Resend unset in development. Do not copy production mail credentials.
# Local backend HTTPS additionally needs a self-signed server.key/server.crt.
# The database-free preview does not use this file or OAuth.
